createOrReplace

	relationship 7c1f2a10-4b8d-4e9a-9a11-100000000001
		fromColumn: fact_sales.customer_id
		toColumn: dim_customer.customer_id

	relationship 7c1f2a10-4b8d-4e9a-9a11-100000000002
		fromColumn: fact_sales.order_date_key
		toColumn: dim_date.date_key

	table _Measures
		lineageTag: 7c1f2a10-4b8d-4e9a-9a11-200000000000

		measure 'Total Sales' = SUM(fact_sales[sales_amount])
			formatString: $#,##0.00
			lineageTag: 7c1f2a10-4b8d-4e9a-9a11-200000000001

		measure 'Total Profit' = SUM(fact_sales[profit])
			formatString: $#,##0.00
			lineageTag: 7c1f2a10-4b8d-4e9a-9a11-200000000002

		measure 'Profit Margin %' = DIVIDE([Total Profit], [Total Sales], 0)
			formatString: 0.00%;-0.00%;0.00%
			lineageTag: 7c1f2a10-4b8d-4e9a-9a11-200000000003

		measure 'Total Orders' = DISTINCTCOUNT(fact_sales[order_id])
			formatString: #,##0
			lineageTag: 7c1f2a10-4b8d-4e9a-9a11-200000000004

		measure 'Unique Customers' = DISTINCTCOUNT(fact_sales[customer_id])
			formatString: #,##0
			lineageTag: 7c1f2a10-4b8d-4e9a-9a11-200000000005

		measure 'Total Units Sold' = SUM(fact_sales[quantity])
			formatString: #,##0
			lineageTag: 7c1f2a10-4b8d-4e9a-9a11-200000000006

		measure 'Average Order Value' = DIVIDE([Total Sales], [Total Orders], 0)
			formatString: $#,##0.00
			lineageTag: 7c1f2a10-4b8d-4e9a-9a11-200000000007

		measure 'Total Shipping Cost' = SUM(fact_sales[shipping_cost])
			formatString: $#,##0.00
			lineageTag: 7c1f2a10-4b8d-4e9a-9a11-200000000008

		measure 'Sales PM' = CALCULATE([Total Sales], PREVIOUSMONTH(dim_date[full_date]))
			formatString: $#,##0.00
			lineageTag: 7c1f2a10-4b8d-4e9a-9a11-200000000009

		measure 'Sales MoM Growth %' = DIVIDE([Total Sales] - [Sales PM], [Sales PM], 0)
			formatString: 0.00%;-0.00%;0.00%
			lineageTag: 7c1f2a10-4b8d-4e9a-9a11-200000000010

		measure 'Sales YTD' = TOTALYTD([Total Sales], dim_date[full_date])
			formatString: $#,##0.00
			lineageTag: 7c1f2a10-4b8d-4e9a-9a11-200000000011

		measure 'Sales PY' = CALCULATE([Total Sales], SAMEPERIODLASTYEAR(dim_date[full_date]))
			formatString: $#,##0.00
			lineageTag: 7c1f2a10-4b8d-4e9a-9a11-200000000012

		measure 'Sales YoY Growth %' = DIVIDE([Total Sales] - [Sales PY], [Sales PY], 0)
			formatString: 0.00%;-0.00%;0.00%
			lineageTag: 7c1f2a10-4b8d-4e9a-9a11-200000000013

		measure 'Running Total Sales' = CALCULATE([Total Sales], FILTER(ALLSELECTED(dim_date[full_date]), dim_date[full_date] <= MAX(dim_date[full_date])))
			formatString: $#,##0.00
			lineageTag: 7c1f2a10-4b8d-4e9a-9a11-200000000014

		measure 'Product Sales Rank' = RANKX(ALLSELECTED(dim_product[product_name]), [Total Sales], , DESC, DENSE)
			formatString: #,##0
			lineageTag: 7c1f2a10-4b8d-4e9a-9a11-200000000015

		measure 'Top 10 Products Sales' = IF([Product Sales Rank] <= 10, [Total Sales], BLANK())
			formatString: $#,##0.00
			lineageTag: 7c1f2a10-4b8d-4e9a-9a11-200000000016

		measure 'Regional Sales Share %' = DIVIDE([Total Sales], CALCULATE([Total Sales], ALLSELECTED(dim_geography)), 0)
			formatString: 0.00%;-0.00%;0.00%
			lineageTag: 7c1f2a10-4b8d-4e9a-9a11-200000000017

		measure 'Fact Row Count' = COUNTROWS(fact_sales)
			formatString: #,##0
			lineageTag: 7c1f2a10-4b8d-4e9a-9a11-200000000018

		column Dummy
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: [Dummy]
			lineageTag: 7c1f2a10-4b8d-4e9a-9a11-200000000099

		partition _Measures = calculated
			mode: import
			source = ROW("Dummy", BLANK())
